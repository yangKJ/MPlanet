    {
      "name": "View",
      "source_files": "WMMineModules/Classes/View/*.swift"
    },
    {
      "name": "Model",
      "source_files": "WMMineModules/Classes/Model/*.swift"
    },
    {
      "name": "CTMediator",
      "source_files": "WMMineModules/Classes/CTMediator/*.swift"
    }
  ],
  "swift_version": "5.0"
