ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/Cabinets" "${PODS_CONFIGURATION_BUILD_DIR}/DZNEmptyDataSet" "${PODS_CONFIGURATION_BUILD_DIR}/FeatBox" "${PODS_CONFIGURATION_BUILD_DIR}/HBDNavigationBar" "${PODS_CONFIGURATION_BUILD_DIR}/HandyJSON" "${PODS_CONFIGURATION_BUILD_DIR}/Harbeth" "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh" "${PODS_CONFIGURATION_BUILD_DIR}/Moya" "${PODS_CONFIGURATION_BUILD_DIR}/Rickenbacker" "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa" "${PODS_CONFIGURATION_BUILD_DIR}/RxNetworks" "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "${PODS_CONFIGURATION_BUILD_DIR}/Toast-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/WMMine" "${PODS_CONFIGURATION_BUILD_DIR}/Wintersweet" "${PODS_CONFIGURATION_BUILD_DIR}/YYCache" "${PODS_CONFIGURATION_BUILD_DIR}/YYText"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Cabinets/Cabinets.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DZNEmptyDataSet/DZNEmptyDataSet.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FeatBox/FeatBox.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HBDNavigationBar/HBDNavigationBar.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HandyJSON/HandyJSON.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Harbeth/Harbeth.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD/MBProgressHUD.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh/MJRefresh.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Moya/Moya.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Rickenbacker/Rickenbacker.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa/RxCocoa.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxNetworks/RxNetworks.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay/RxRelay.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift/RxSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Toast-Swift/Toast_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WMMine/WMMine.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Wintersweet/Wintersweet.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYCache/YYCache.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYText/YYText.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${DT_TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Cabinets/Cabinets.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/DZNEmptyDataSet/DZNEmptyDataSet.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/FeatBox/FeatBox.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/HBDNavigationBar/HBDNavigationBar.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/HandyJSON/HandyJSON.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Harbeth/Harbeth.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD/MBProgressHUD.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh/MJRefresh.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Moya/Moya.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Rickenbacker/Rickenbacker.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa/RxCocoa.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/RxNetworks/RxNetworks.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay/RxRelay.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift/RxSwift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Toast-Swift/Toast_Swift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/WMMine/WMMine.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Wintersweet/Wintersweet.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYCache/YYCache.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/YYText/YYText.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Cabinets" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/DZNEmptyDataSet" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/FeatBox" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/HBDNavigationBar" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/HandyJSON" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Harbeth" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Moya" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Rickenbacker" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/RxNetworks" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Toast-Swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/WMMine" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Wintersweet" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYCache" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/YYText"
OTHER_LDFLAGS = $(inherited) -ObjC -l"c++" -l"sqlite3" -framework "Accelerate" -framework "Alamofire" -framework "CFNetwork" -framework "Cabinets" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreText" -framework "DZNEmptyDataSet" -framework "FeatBox" -framework "Foundation" -framework "HBDNavigationBar" -framework "HandyJSON" -framework "Harbeth" -framework "MBProgressHUD" -framework "MJRefresh" -framework "MobileCoreServices" -framework "Moya" -framework "QuartzCore" -framework "Rickenbacker" -framework "RxCocoa" -framework "RxNetworks" -framework "RxRelay" -framework "RxSwift" -framework "SnapKit" -framework "Toast_Swift" -framework "UIKit" -framework "WMMine" -framework "Wintersweet" -framework "YYCache" -framework "YYText" -weak_framework "AVFoundation" -weak_framework "CoreImage" -weak_framework "ImageIO" -weak_framework "MetalKit" -weak_framework "MetalPerformanceShaders"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
